{
  "name": "@reactive-resume/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reactive Resume standalone Hono + oRPC API",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./router": {
      "types": "./src/orpc/router.ts",
      "default": "./src/orpc/router.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.105",
    "@ai-sdk/google": "^3.0.103",
    "@ai-sdk/openai": "^3.0.90",
    "@ai-sdk/openai-compatible": "^2.0.63",
    "@aws-sdk/client-s3": "^3.1104.0",
    "@better-auth/api-key": "^1.6.9",
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@better-auth/infra": "^0.2.5",
    "@better-auth/oauth-provider": "^1.6.9",
    "@better-auth/passkey": "^1.6.9",
    "@google/genai": "^2.16.0",
    "@hono/node-server": "^1.14.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc/client": "^1.14.0",
    "@orpc/experimental-ratelimit": "^1.14.14",
    "@orpc/server": "^1.14.14",
    "@react-email/render": "^1.1.2",
    "@sindresorhus/slugify": "^3.0.0",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "^6.0.244",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.9",
    "bullmq": "^6.0.8",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "drizzle-orm": "1.0.0-beta.22",
    "drizzle-zod": "1.0.0-beta.14-a36c63d",
    "es-toolkit": "^1.50.0",
    "fast-json-patch": "^3.1.1",
    "hono": "^4.8.5",
    "immer": "^10.1.1",
    "ioredis": "^5.6.1",
    "isomorphic-dompurify": "^2.25.0",
    "jose": "^6.0.11",
    "jsonrepair": "^3.15.0",
    "nodemailer": "^7.0.3",
    "ollama-ai-provider-v2": "^3.6.0",
    "pg": "^8.20.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "puppeteer-core": "^24.43.1",
    "react": "^19.1.0",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "sharp": "^0.34.5",
    "ts-pattern": "^5.9.0",
    "unique-names-generator": "^4.7.1",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.15.32",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.4",
    "@types/sharp": "^0.32.0",
    "drizzle-kit": "1.0.0-beta.22",
    "oxlint": "^1.6.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
