{
  "name": "@reactive-resume/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reactive Resume standalone Hono + oRPC API",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.8.5",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "@t3-oss/env-core": "^0.13.11",
    "drizzle-orm": "1.0.0-beta.22",
    "ioredis": "^5.6.1",
    "pg": "^8.20.0",
    "uuid": "^11.1.0",
    "zod": "^4.4.3",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "oxlint": "^1.6.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "1.0.0-beta.22"
  }
}
