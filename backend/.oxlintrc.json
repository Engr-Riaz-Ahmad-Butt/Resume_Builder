{
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "eslint/no-underscore-dangle": "off",
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "coverage/**"]
}
